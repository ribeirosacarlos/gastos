# Copiar para .env na VPS (ao lado do docker-compose.yml) e preencher.
# NUNCA commitar o .env real - contem segredos.

POSTGRES_PASSWORD=troque-por-uma-senha-forte

# Minimo 32 caracteres. Gere com: openssl rand -base64 32
SESSION_SECRET=

# Seed dos 2 usuarios fixos (so usado se rodar `prisma db seed` manualmente -
# o deploy normal restaura os dados reais via scripts/restore-db.ts)
SEED_USER1_USERNAME=
SEED_USER1_PASSWORD=
SEED_USER1_NAME=
SEED_USER2_USERNAME=
SEED_USER2_PASSWORD=
SEED_USER2_NAME=

# Open Finance (Pluggy) - copiar os mesmos valores do .env local
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
