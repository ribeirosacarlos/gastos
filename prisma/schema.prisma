// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id             String   @id @default(cuid())
  name           String
  username       String   @unique
  passwordHash   String
  lastUsedCardId String?
  lastUsedCard   Card?    @relation("UserLastUsedCard", fields: [lastUsedCardId], references: [id])
  createdAt      DateTime @default(now())

  ownedCards         Card[]         @relation("CardOwner")
  ownedPurchases     Purchase[]     @relation("PurchaseOwner")
  chargedPurchases   Purchase[]     @relation("PurchaseChargedUser")
  ownedFixedExpenses FixedExpense[] @relation("FixedExpenseOwner")
  purchaseParticipations PurchaseParticipant[] @relation("PurchaseParticipant")
}

model Card {
  id          String   @id @default(cuid())
  name        String
  bank        String
  limitCents  Int
  // Codigo ISO 4217. String (nao enum) para permitir novas moedas sem migration
  // - ver SUPPORTED_CURRENCIES em lib/money.ts (Story 1.4+)
  currency    String   @default("BRL")
  // Hex de 6 digitos (#rrggbb), validado na aplicacao (cardSchema). Livre,
  // nao enum - mesmo padrao de currency.
  color       String   @default("#64748b")
  closingDay  Int
  dueDay      Int
  ownerUserId String
  owner       User     @relation("CardOwner", fields: [ownerUserId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  purchases    Purchase[]
  lastUsedByUsers User[] @relation("UserLastUsedCard")
}

model Purchase {
  id                String   @id @default(cuid())
  cardId            String
  card              Card     @relation(fields: [cardId], references: [id])
  description       String
  totalCents        Int
  purchaseDate      DateTime
  installmentsCount Int
  // Id da Category (tabela), string livre sem FK declarativa - mesmo padrao
  // de card.currency. Categorias viraram cadastro em banco (model Category),
  // evolucao da lista fixa da Story 1.13 - "other" e as demais categorias
  // fixas dessa story foram seedadas com id = codigo antigo na migration
  // pra nao quebrar dados existentes.
  category          String   @default("other")
  // Dono = sempre o titular do cartao usado (quem pode editar a compra).
  // Divisao de valor e visibilidade sao definidas por PurchaseParticipant,
  // nao por um booleano - o dono e sempre um dos participantes (garantido
  // na camada de aplicacao).
  ownerUserId       String
  owner             User     @relation("PurchaseOwner", fields: [ownerUserId], references: [id])
  // null = divide igualmente entre os participantes; preenchido = essa
  // pessoa (um participante adicional) paga 100% da compra, mesmo com o
  // cartao sendo do ownerUserId.
  chargedUserId     String?
  chargedUser       User?    @relation("PurchaseChargedUser", fields: [chargedUserId], references: [id])
  // Soft-delete: false = excluida, some das listagens/totais. Mesmo padrao
  // de Card.isActive/FixedExpense.isActive (Story 1.14).
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())

  installments PurchaseInstallment[]
  participants PurchaseParticipant[]
}

// Todo participante de uma compra, incluindo o dono (Purchase.ownerUserId
// tambem aparece aqui como 1 linha). 1 linha = compra nao dividida; 2+ =
// dividida igualmente entre todos - ver splitAmongParticipants em money.ts.
model PurchaseParticipant {
  id         String   @id @default(cuid())
  purchaseId String
  purchase   Purchase @relation(fields: [purchaseId], references: [id])
  userId     String
  user       User     @relation("PurchaseParticipant", fields: [userId], references: [id])

  @@unique([purchaseId, userId])
}

model PurchaseInstallment {
  id                String    @id @default(cuid())
  purchaseId        String
  purchase          Purchase  @relation(fields: [purchaseId], references: [id])
  installmentNumber Int
  referenceYear     Int
  referenceMonth    Int
  valueCents        Int
  paid              Boolean   @default(false)
  paidAt            DateTime?

  @@unique([purchaseId, installmentNumber])
  @@index([referenceYear, referenceMonth])
}

model FixedExpense {
  id          String   @id @default(cuid())
  description String
  valueCents  Int
  // Codigo ISO 4217, default BRL. Sem cartao associado, entao carrega a propria moeda.
  currency    String   @default("BRL")
  // Id da Category (tabela) - ver comentario equivalente em Purchase.category.
  category    String   @default("other")
  startYear   Int
  startMonth  Int
  // null = recorrente indefinido (ex. aluguel); numero = quantidade fixa de parcelas
  totalInstallments Int?
  // Mesma invariante isShared/ownerUserId do Purchase (validada na aplicacao)
  isShared    Boolean  @default(false)
  ownerUserId String?
  owner       User?    @relation("FixedExpenseOwner", fields: [ownerUserId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  installments FixedExpenseInstallment[]
}

model FixedExpenseInstallment {
  id                String    @id @default(cuid())
  fixedExpenseId    String
  fixedExpense      FixedExpense @relation(fields: [fixedExpenseId], references: [id])
  installmentNumber Int
  referenceYear     Int
  referenceMonth    Int
  valueCents        Int
  paid              Boolean   @default(false)
  paidAt            DateTime?

  @@unique([fixedExpenseId, referenceYear, referenceMonth])
}

model Category {
  id        String   @id @default(cuid())
  name      String
  // Soft-delete, mesmo padrao de Card.isActive/FixedExpense.isActive.
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
}

model ExchangeRate {
  id        String   @id @default(cuid())
  // Codigo ISO 4217, unico. Sem registro para BRL (taxa implicita = 1)
  currency  String   @unique
  rateToBRL Float
  source    String
  updatedAt DateTime @updatedAt
}
